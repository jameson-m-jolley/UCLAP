┌─╴tools
  Red   ← "\u001b[31m"
  Green ← "\u001b[32m"
  Blue  ← "\u001b[34m"
  Reset ← "\u001b[0m"

  # ApplyColor takes
  # 
  # 1. `color` - an ANSI escape sequence (a string)
  # 2. `text` - a string to wrap in color
  # 
  # wraps `text` with the escape sequence followed by Reset, leaving the
  # surrounding strings unwrapped (⊂) so callers can print them directly
  # 
  # >provence:
  # >>documentation generated with `opencode (model: laguna-s-2.1-free)`
  # 
  # >>code generated with `human`
  ApplyColor ← (˜⊂ Reset ⊂)

└─╴

┌─╴core
  ┌─╴lexer ~ Lex
    # token names use screaming snake case eg `KEY_VALUE`
    # the token patterns are regexes that match the token names
    # the patterns are positionally ordered so the some tokens take precedence 
    # over others (eg `LONG` takes precedence over `SHORT` )
    # 
    # >provence:
    # >>documentation generated with `human`
    # 
    # >>code generated with `human`
    TokenNames ← {"KEY_VALUE" "LONG" "SHORT" "STRING" "LITERAL" "NUMBER"}
    # regex patterns for the tokens we want to match
    # 
    # mapped to the token names in `TokenNames` with `TokenMAP`
    # >provence:
    # >>documentation generated with `human`
    # 
    # >>code generated with `human`
    TokenPatterns ← {"--[a-zA-Z]+=[a-zA-Z]+" "--[a-zA-Z]+" "-[a-zA-Z]" "\"([^\"\\\\]|\\\\.)*\"" "[a-zA-Z.\\/~*_]+" "-?[0-9]+(\\.[0-9]+)?"}
    # mapping the token names in `TokenNames` to the regex patterns in `TokenPatterns`
    # >provence:
    # >>documentation generated with `human`
    # 
    # >>code generated with `human`
    TokenMap ← map TokenNames TokenPatterns
    # the regex pattern for the tokenizer to use to split the args into tokens
    # >provence:
    # >>documentation generated with `human`
    # 
    # >>code generated with `human`
    TokenizerPattern ← ⊂⊂"("↘1°□/(□⊂∩°□)≡(□⊂@| °□˜get°□TokenMap)TokenNames")"
    # ----------------------------

    # JoinTokenized takes
    # 
    # 1. `tokens` - an array of string tokens
    # 
    # joins the tokens into a single space-separated string so the regex
    # tokenizer can split them back into the correct tagged tokens
    # 
    # >provence:
    # >>documentation generated with opencode (model: laguna-s-2.1-free)
    # 
    # >>code generated with human
    JoinTokenized ← |1 ⍣(°□ /(□⊂ ˜⊂@ ∩°□))@ 

    # Tokenize takes
    # 
    # 1. `args` - a raw command line string
    # 
    # runs TokenizerPattern against the string and returns the array of
    # matched token substrings (empty strings are dropped)
    # 
    # >provence:
    # >>documentation generated with opencode (model: laguna-s-2.1-free)
    # 
    # >>code generated with human
    Tokenize ← |1 ♭↙1⍉ ⬚""regex TokenizerPattern

    # the match token function takes 
    # 
    # 1. `token name` 
    # 2. `token value` 
    # 
    # returns `1` if the token value matches the regex pattern for the token name 
    # and `0` if it does not
    # 
    # >provence:
    # >>documentation generated by `copilot` and modified by `Jameson Jolley`
    # 
    # >>code generated with `human`
    MatchToken ← |2 ≍ ⍣(°□⊡0)("") ♭ ⬚""regex get ⊙TokenMap ⊙⟜∘

    # GetTokenTypeMask takes 
    # 
    # 1. `token string` 
    # 
    # returns the a mask for the correct token types 
    # 
    # >provence:
    # >>documentation generated by `human`
    # 
    # >>code generated with `human`
    GetTokenTypeMask ← |1 (≡(MatchToken°□⊙°□)TokenNames□)

    # GetTokenTypeMask takes 
    # 
    # 1. `list of token string` 
    # 
    # returns the a 2d mask for the correct token types 
    # 
    # >provence:
    # >>documentation generated by `human`
    # 
    # >>code generated with `human`
    GetTokenTypeMatrix ← |1 (≡(GetTokenTypeMask°□))

    # GetTokenType takes 
    # 
    # 1. `token string` 
    # 
    # returns the `TokenName`
    # 
    # >provence:
    # >>documentation generated by `human`
    # 
    # >>code generated with `human`
    GetTokenType ← |1 (°□°¤↙1˜▽TokenNames GetTokenTypeMask)

    # MapTokens takes
    # 
    # 1. `token values` - an array of token values
    # 
    # returns a map of `Tokens` -> `Token types`
    # >provence:
    # >>documentation generated by `human`
    # 
    # >>code generated with `human`
    MapTokens ← |1 (˜map ⍣(°¤)[] ⍉≡(˜▽TokenNames) GetTokenTypeMatrix ⟜∘)

    # Lex takes no arguments and is the entry point of the lexer.
    # currently a placeholder; future work will drive tokenization and
    # tagging here into a tagged token record
    # 
    # >provence:
    # >>documentation generated with `opencode (model: laguna-s-2.1-free)`
    # 
    # >>code generated with human
    Lex ← (MapTokens Tokenize JoinTokenized ↘1&args)
  └─╴
  ┌─╴parsers
    # llkWindows takes
    # 1. the map of the lexed tokens
    # 
    # returns a parwise windows of tokens for parsing mapped to toking type 
    # 
    # >provence:
    # >>documentation generated with `human`
    # 
    # >>code generated with `humans`
    llkWindows ← (map ∩(⧈□2) °map)

  └─╴

  # PrintHelp takes no arguments and prints the CLAP-style help scaffold:
  # the Usage/Commands/Options section headers in green
  # 
  # >provence:
  # >>documentation generated with `opencode (model: laguna-s-2.1-free)`
  # 
  # >>code generated with `human`
  PrintHelp ← (
    &p tools~ApplyColor tools~Green "Usage:"
    &p tools~ApplyColor tools~Green "Commands:"
    &p tools~ApplyColor tools~Green "Options:"
  )
└─╴

┌─╴legacy
  # this is for getting the keys for the args

  # Getkeys takes
  # 
  # 1. `args` - an array of `key=value` strings
  # 
  # returns the array of keys split out on `=`
  # 
  # >provence:
  # >>documentation generated with `opencode (model: laguna-s-2.1-free)`
  # 
  # >>code generated with `human`
  Getkeys ← (≡(⊢ ⊜□ ⊸≠@= °□)↘1&args)

  # Getvalues takes
  # 
  # 1. `args` - an array of `key=value` strings
  # 
  # returns the array of values split out on `=`
  # 
  # >provence:
  # >>documentation generated with `opencode (model: laguna-s-2.1-free)`
  # 
  # >>code generated with `human`
  Getvalues ← (≡(⊣ ⊜□ ⊸≠@= °□)↘1&args)

  # GetArgs takes
  # 
  # 1. `args` - an array of `key=value` strings
  # 
  # zips Getkeys and Getvalues into an ordered map of key -> value
  # 
  # >provence:
  # >>documentation generated with `opencode (model: laguna-s-2.1-free)`
  # 
  # >>code generated with `human`
  GetArgs ← (map Getkeys Getvalues)

  # GetArgValue takes
  # 
  # 1. `args` - an array of `key=value` strings
  # 
  # returns the value for the first key matched by `get` and parsed as a
  # number, or empty on no match
  # 
  # >provence:
  # >>documentation generated with `opencode (model: laguna-s-2.1-free)`
  # 
  # >>code generated with `human`
  GetArgValue ← (⋕°□get□)

  # PrintUsage takes no arguments and prints the legacy mode usage banner:
  # the header, the key=value delimiter explanation, and an example line
  # 
  # >provence:
  # >>documentation generated with `opencode (model: laguna-s-2.1-free)`
  # 
  # >>code generated with `human`
  PrintUsage ← (
    &p tools~ApplyColor tools~Red "UCLAP legacy mode parser"
    &p tools~ApplyColor tools~Green "Usage:"
    &p "-------------------------------------------------"
    &p ⊂ "takes a list of" ⊂ tools~ApplyColor tools~Red" key=value " "delimited by a space"
    &p "example:"
    &p "    uiua script.ua key=val key2=val2"
  )
